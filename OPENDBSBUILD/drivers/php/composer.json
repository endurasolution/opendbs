    "type": "library",
    "keywords": ["opendbs", "database", "client", "sql", "nosql"],
    "homepage": "https://github.com/endurasolution/opendbs",
    "license": "CC-BY-NC-4.0",
    "authors": [
        { "name": "OpenDBS Team" }
    ],
    "support": {
        "issues": "https://github.com/endurasolution/opendbs/issues",
        "source": "https://github.com/endurasolution/php-opendbs"
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "files": ["src/OpenDBS.php"]
    },
    "minimum-stability": "stable"
}
