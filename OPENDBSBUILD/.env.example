# Environment Configuration
NODE_ENV=development
PORT=4402
HOST=0.0.0.0

# Database Configuration
DB_PATH=./data
DB_MODE=nosql

# ── Security ──────────────────────────────────────────────────────────────
# REQUIRED in production (server refuses to start otherwise): 32+ random chars.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In development, if left empty a random secret is generated into data/.jwt_secret.
JWT_SECRET=
API_KEY_SALT=your-api-key-salt
JWT_EXPIRATION_DAYS=7
# bcrypt cost (10-15). 12 is a good production value.
BCRYPT_ROUNDS=10
# Password for the 'admin' user created on first start. If empty, a random
# password is generated and printed once to the console.
ADMIN_PASSWORD=
# Set true only when running behind a reverse proxy (nginx, Caddy, a load
# balancer) so client IPs come from X-Forwarded-For. Leave false otherwise.
TRUST_PROXY=false
# Comma-separated allowed browser origins, e.g. https://app.example.com
# Empty = any origin in development, none in production.
CORS_ORIGINS=
# Requests per minute per IP (login has its own stricter limit)
RATE_LIMIT_MAX=300
BODY_LIMIT_MB=50
# Upper bound for ?_limit / search limit
MAX_QUERY_LIMIT=10000
# Show the OpenDBS version without login (GET /api/version, /health).
# Empty = yes in development, no in production.
EXPOSE_VERSION=

# Logging
LOG_LEVEL=info

# ── Storage engine ────────────────────────────────────────────────────────
# disk   = documents and indexes live in one encrypted on-disk B-tree
#          (data/.storage/opendbs.odb, AES-256-XTS) with a RAM cache of
#          CACHE_SIZE_MB, so databases can be far larger than memory. Writes are
#          ACID and committed in groups. (recommended)
# memory = everything in RAM, saved as per-rack snapshots + WAL (fast for small data).
# Switching converts existing data automatically on the next start.
STORAGE_ENGINE=disk

# ── Replication / automatic failover (disk engine) ───────────────────────
# Run 3+ servers as one cluster: one primary takes writes, replicas keep identical
# copies and serve reads (writes sent to a replica are forwarded), and if the primary
# fails the others elect a new one within seconds. Set on EVERY member:
CLUSTER_ENABLED=false
# Unique name of this member (default: its address)
CLUSTER_NODE_ID=
# How the other members reach THIS server (must match their CLUSTER_PEERS entry)
CLUSTER_ADVERTISE_URL=
# The OTHER members, comma-separated, e.g. http://10.0.0.6:4402,http://10.0.0.7:4402
CLUSTER_PEERS=
# Same on all members, 32+ random characters (authenticates + encrypts cluster traffic)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLUSTER_SECRET=
# async = acknowledge after the primary's commit; majority = after most members have it
# (no acknowledged write is lost on failover)
REPLICATION_SYNC=async
# How long the primary may be unreachable before a new one is elected
CLUSTER_ELECTION_TIMEOUT_MS=5000
# Higher = preferred primary; 0 = never primary
CLUSTER_PRIORITY=1
# Note: a member joining with data that differs from the cluster's is backed up to
# BACKUP_PATH and then replaced by a copy of the primary's data.

# ── Performance ───────────────────────────────────────────────────────────
MAX_CONNECTIONS=1000
# Threads that scan large racks in parallel (disk engine). Empty = auto, 0 = off.
QUERY_WORKERS=
# Disk engine: RAM for hot documents + B-tree pages. More = fewer disk reads.
CACHE_SIZE_MB=512
ENABLE_COMPRESSION=true
# Writes go to a write-ahead log immediately; the compressed snapshot is
# rewritten in the background after this many ms without writes (max 30s
# under continuous load). 0 = old behaviour: full snapshot on every write.
PERSIST_DEBOUNCE_MS=1000
# Acknowledge a write only after it is on disk (survives power loss).
WAL_FSYNC=true
# ── Encryption at rest (disk engine: AES-256-XTS · memory engine & backups: AES-256-GCM) ──
# Data files, write logs and backups are encrypted. Key source (first match):
#   DB_ENCRYPTION_KEY=<64 hex chars>   (best: from a secrets manager)
#   DB_ENCRYPTION_KEY_FILE=/path/to/keyfile
#   ./opendbs.key  (generated on first start)
# !! Without the key the data and backups CANNOT be read. Keep a safe copy. !!
ENCRYPTION_AT_REST=true
DB_ENCRYPTION_KEY=
DB_ENCRYPTION_KEY_FILE=
# Cached query results (invalidated automatically on writes). 0 disables.
QUERY_CACHE_ENTRIES=1000

# Search
ENABLE_FUZZY_SEARCH=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_VECTOR_SEARCH=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=./backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_TYPE=local
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=

# SQL Configuration
SQL_ENABLED=true
SQL_PORT=3306
API_PORT=4402
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=opendbs

# ── Web interfaces ────────────────────────────────────────────────────────
# User-facing web UI at /web/
WEB_INTERFACE_ENABLED=true
# Allow admins to view/edit this .env from the browser (secrets are masked)
SHOW_ENVONWEB=false

# Admin panel: databases, racks/tables, documents, indexes, users, backups,
# audit log and server health. Admin-role accounts only.
ADMIN_PANEL_ENABLED=true
# URL path of the admin panel — choose your own. Examples:
#   /admin               → http://your-server:4402/admin/
#   /ops-7f3a            → harder to find for bots and scanners
#   /company/console     → up to 4 parts; letters, numbers, - and _
# Must not start with /api, /web or /health. Restart the server after changing it.
ADMIN_PANEL_PATH=/admin
# Optional comma-separated IP allow-list for the panel and /api/admin
# e.g. 127.0.0.1,::1,203.0.113.10   (empty = any IP, login still required)
ADMIN_ALLOWED_IPS=
# Require two-factor auth for every admin session. Turn on only after each
# admin has enabled 2FA (admin panel → Settings); admins without it can then
# only reach the 2FA setup screen.
ADMIN_REQUIRE_2FA=false
# Admin panel signs out after this many idle minutes
ADMIN_SESSION_TIMEOUT_MINUTES=30

# Note: backup schedule/destination edited in the admin panel (Backups page)
# are stored in DB_PATH/.config/backup.json and override the BACKUP_* values.
